{
  "name": "novex",
  "private": true,
  "version": "0.1.0",
  "description": "NOVEX - SaaS multi-tenant de gestion des associations.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "lint:frontend": "npm --workspace frontend run lint",
    "typecheck:frontend": "npm --workspace frontend run typecheck",
    "test:frontend": "npm --workspace frontend run test",
    "test:backend": "pytest backend",
    "lint:backend": "ruff check backend",
    "format:backend": "ruff format backend",
    "typecheck:backend": "mypy backend"
  },
  "engines": {
    "node": ">=22.0.0",
    "python": ">=3.12"
  }
}
